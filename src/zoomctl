#!/usr/bin/env bash
set -euo pipefail

script_directory="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
share_directory="${ZOOMCTL_SHARE_DIR:-/usr/share/hyprland-zoom}"

if [ -d "$script_directory/lib" ]; then
  # Running from the repository checkout.
  lib_directory="$script_directory/lib"
else
  lib_directory="$share_directory/lib"
fi

source "$lib_directory/math.sh"
source "$lib_directory/config.sh"
source "$lib_directory/state.sh"
source "$lib_directory/hyprland.sh"
source "$lib_directory/setup.sh"

zoomctl_apply_zoom() {
  local current_zoom
  local requested_zoom
  local clamped_zoom

  current_zoom="$(zoomctl_hyprland_get_zoom)"
  requested_zoom="$(zoomctl_add_float "$current_zoom" "$1")"
  clamped_zoom="$(zoomctl_clamp_float "$requested_zoom" "$ZOOMCTL_MIN" "$ZOOMCTL_MAX")"

  zoomctl_hyprland_set_zoom "$clamped_zoom"
  zoomctl_hyprland_center_cursor
}

zoomctl_command_in() {
  zoomctl_apply_zoom "$ZOOMCTL_STEP"
}

zoomctl_command_out() {
  zoomctl_apply_zoom "-$(zoomctl_format_float "$ZOOMCTL_STEP")"
}

zoomctl_command_toggle() {
  local current_zoom
  local stored_zoom

  current_zoom="$(zoomctl_hyprland_get_zoom)"

  if zoomctl_float_gt "$current_zoom" "$ZOOMCTL_RESET"; then
    zoomctl_state_save "$current_zoom"
    zoomctl_hyprland_set_zoom "$ZOOMCTL_RESET"
    zoomctl_hyprland_center_cursor
    return 0
  fi

  if stored_zoom="$(zoomctl_state_read)"; then
    zoomctl_hyprland_set_zoom "$stored_zoom"
    zoomctl_state_clear
  else
    zoomctl_hyprland_set_zoom "$ZOOMCTL_RESET"
  fi

  zoomctl_hyprland_center_cursor
}

zoomctl_command_reset() {
  zoomctl_hyprland_set_zoom "$ZOOMCTL_RESET"
  zoomctl_state_clear
  zoomctl_hyprland_center_cursor
}

zoomctl_command_status() {
  local current_zoom
  local stored_zoom

  current_zoom="$(zoomctl_hyprland_get_zoom)"
  stored_zoom="$(zoomctl_state_read 2>/dev/null || true)"

  cat <<EOF
Hyprland zoom status
  Current zoom: $current_zoom
  Reset zoom:   $ZOOMCTL_RESET
  Step:         $ZOOMCTL_STEP
  Bounds:       $ZOOMCTL_MIN .. $ZOOMCTL_MAX
  State dir:    $(zoomctl_state_directory)
  Saved zoom:   ${stored_zoom:-<none>}
  Cursor center: $ZOOMCTL_CENTER_CURSOR
EOF
}

zoomctl_command_show_config() {
  cat <<EOF
Active zoomctl configuration
$(zoomctl_config_summary)
EOF
}

zoomctl_run_privileged() {
  if [ "$(id -u)" = '0' ]; then
    "$@"
    return $?
  fi

  if command -v sudo >/dev/null 2>&1; then
    sudo "$@"
    return $?
  fi

  if command -v doas >/dev/null 2>&1; then
    doas "$@"
    return $?
  fi

  if command -v pkexec >/dev/null 2>&1; then
    pkexec "$@"
    return $?
  fi

  printf 'zoomctl: uninstall requires sudo, doas, or pkexec\n' >&2
  return 1
}

zoomctl_prompt_value() {
  local prompt="$1"
  local default_value="$2"
  local response

  if command -v zenity >/dev/null 2>&1; then
    response="$(zenity --entry --title='hyprland-zoom' --text="$prompt" --entry-text="$default_value")" || return 1
    printf '%s\n' "$response"
    return 0
  fi

  if command -v yad >/dev/null 2>&1; then
    response="$(yad --entry --title='hyprland-zoom' --text="$prompt" --entry-text="$default_value")" || return 1
    printf '%s\n' "$response"
    return 0
  fi

  printf '%s [%s]: ' "$prompt" "$default_value"
  read -r response
  if [ -z "$response" ]; then
    response="$default_value"
  fi

  printf '%s\n' "$response"
}

zoomctl_pick_menu() {
  local prompt="$1"
  shift
  local selection

  if command -v wofi >/dev/null 2>&1; then
    selection="$(printf '%s\n' "$@" | wofi --dmenu --prompt "$prompt")" || return 1
    printf '%s\n' "$selection"
    return 0
  fi

  if command -v rofi >/dev/null 2>&1; then
    selection="$(printf '%s\n' "$@" | rofi -dmenu -p "$prompt")" || return 1
    printf '%s\n' "$selection"
    return 0
  fi

  if command -v fuzzel >/dev/null 2>&1; then
    selection="$(printf '%s\n' "$@" | fuzzel --dmenu --prompt "$prompt")" || return 1
    printf '%s\n' "$selection"
    return 0
  fi

  if command -v bemenu >/dev/null 2>&1; then
    selection="$(printf '%s\n' "$@" | bemenu -i -p "$prompt")" || return 1
    printf '%s\n' "$selection"
    return 0
  fi

  printf '%s\n' "$@" | nl -w1 -s': ' >&2
  printf '%s: ' "$prompt" >&2
  read -r selection

  case "$selection" in
    ''|*[!0-9]*) return 1 ;;
  esac

  selection=$((selection - 1))
  [ "$selection" -ge 0 ] && [ "$selection" -lt "$#" ] || return 1

  set -- "$@"
  eval "printf '%s\\n' \"\${$((selection + 1))}\""
}

zoomctl_write_user_config() {
  local config_file

  config_file="${XDG_CONFIG_HOME:-$HOME/.config}/zoomctl/zoom.conf"
  mkdir -p "$(dirname -- "$config_file")"

  cat > "$config_file" <<EOF
# user overrides for hyprland-zoom
ZOOM_STEP=$ZOOMCTL_STEP
ZOOM_MIN=$ZOOMCTL_MIN
ZOOM_MAX=$ZOOMCTL_MAX
ZOOM_RESET=$ZOOMCTL_RESET
ZOOM_CENTER_CURSOR=$ZOOMCTL_CENTER_CURSOR
EOF

  printf 'zoomctl: wrote %s\n' "$config_file"
}

zoomctl_command_configure() {
  local step
  local minimum
  local maximum
  local reset
  local center_cursor

  step="$(zoomctl_prompt_value 'Zoom step' "$ZOOMCTL_STEP")" || return 1
  minimum="$(zoomctl_prompt_value 'Minimum zoom' "$ZOOMCTL_MIN")" || return 1
  maximum="$(zoomctl_prompt_value 'Maximum zoom' "$ZOOMCTL_MAX")" || return 1
  reset="$(zoomctl_prompt_value 'Reset zoom' "$ZOOMCTL_RESET")" || return 1
  center_cursor="$(zoomctl_prompt_value 'Center cursor after zoom? 0 or 1' "$ZOOMCTL_CENTER_CURSOR")" || return 1

  ZOOMCTL_STEP="$step"
  ZOOMCTL_MIN="$minimum"
  ZOOMCTL_MAX="$maximum"
  ZOOMCTL_RESET="$reset"
  ZOOMCTL_CENTER_CURSOR="$center_cursor"
  zoomctl_config_validate
  zoomctl_write_user_config
}

zoomctl_command_uninstall() {
  local confirmation

  confirmation="$(zoomctl_pick_menu 'Confirm uninstall' 'No' 'Yes')" || return 1
  case "$confirmation" in
    Yes)
      zoomctl_run_privileged pacman -Rns hyprland-zoom
      ;;
    *)
      printf 'zoomctl: uninstall cancelled\n'
      ;;
  esac
}

zoomctl_command_ui() {
  local action

  action="$(zoomctl_pick_menu 'hyprland-zoom' \
    'Zoom in' \
    'Zoom out' \
    'Toggle zoom' \
    'Reset zoom' \
    'Status' \
    'Configure settings' \
    'Install Hyprland include' \
    'Open config file' \
    'Uninstall package' \
    'Quit')" || return 1

  case "$action" in
    'Zoom in') zoomctl_command_in ;;
    'Zoom out') zoomctl_command_out ;;
    'Toggle zoom') zoomctl_command_toggle ;;
    'Reset zoom') zoomctl_command_reset ;;
    'Status') zoomctl_command_status ;;
    'Configure settings') zoomctl_command_configure ;;
    'Install Hyprland include') zoomctl_install_hyprland_include ;;
    'Open config file') zoomctl_command_edit_config ;;
    'Uninstall package') zoomctl_command_uninstall ;;
    'Quit') return 0 ;;
  esac
}

zoomctl_command_edit_config() {
  local config_file

  config_file="${XDG_CONFIG_HOME:-$HOME/.config}/zoomctl/zoom.conf"
  mkdir -p "$(dirname -- "$config_file")"

  if [ -n "${EDITOR:-}" ]; then
    exec "$EDITOR" "$config_file"
  fi

  exec vi "$config_file"
}

zoomctl_usage() {
  cat <<'EOF'
Usage: zoomctl <command>

Commands:
  ui            launch the interactive menu
  setup         add the packaged hyprland-bindings.conf include to hyprland.conf
  in            zoom in by the configured step
  out           zoom out by the configured step
  toggle        toggle the stored zoom against the reset value
  reset         hard reset to the configured reset value
  status        print the active zoom state
  config        print the active configuration
  edit-config   open the user config in $EDITOR
  uninstall     remove the Arch package with a privilege helper
  help          show this help
EOF
}

main() {
  local command

  zoomctl_config_load
  command="${1:-help}"

  case "$command" in
    ui)
      zoomctl_command_ui
      ;;
    setup|install-hyprland)
      zoomctl_install_hyprland_include
      ;;
    in|zoom-in)
      zoomctl_command_in
      ;;
    out|zoom-out)
      zoomctl_command_out
      ;;
    toggle)
      zoomctl_command_toggle
      ;;
    reset|hard-reset)
      zoomctl_command_reset
      ;;
    status)
      zoomctl_command_status
      ;;
    config|show-config)
      zoomctl_command_show_config
      ;;
    edit-config)
      zoomctl_command_edit_config
      ;;
    uninstall|remove)
      zoomctl_command_uninstall
      ;;
    help|-h|--help)
      zoomctl_usage
      ;;
    *)
      printf 'zoomctl: unknown command %s\n' "$command" >&2
      zoomctl_usage >&2
      return 1
      ;;
  esac
}

main "$@"