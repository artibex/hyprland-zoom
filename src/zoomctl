#!/usr/bin/env bash
# zoomctl — command line client of hyprland-zoom 0.2.
#
# With the Lua engine loaded (Hyprland 0.55+ and `zoomctl setup`) every action is one
# `hyprctl eval` into the compositor (contract C4). Without it a flock-serialised bash path
# keeps zoom working on the legacy hyprlang config (decision E8).
#
# Layout: this file only wires the libraries and dispatches; the logic lives in lib/*.sh.
set -u -o pipefail

# Directory of this script; the checkout layout and tests find lib/ and the schema from it.
ZOOMCTL_SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# zoomctl_lib_dir — locate the libraries: next to the script (checkout) or in the share dir.
# Args:    none
# Returns: 0 always; stdout: directory
# Globals: reads ZOOMCTL_SCRIPT_DIR, ZOOMCTL_SHARE_DIR
zoomctl_lib_dir() {
  # A checkout keeps lib/ beside the script; an installed copy uses the share directory.
  if [ -d "$ZOOMCTL_SCRIPT_DIR/lib" ]; then
    printf '%s\n' "$ZOOMCTL_SCRIPT_DIR/lib"
  else
    printf '%s/lib\n' "${ZOOMCTL_SHARE_DIR:-/usr/share/hyprland-zoom}"
  fi
}

# Load every library; order only matters for the constants at the top of each file.
ZOOMCTL_LIB_DIR="$(zoomctl_lib_dir)"
for library in common math validate schema config userconfig template state hyprland \
  engine legacy setup status doctor cmd_zoom cmd_config cmd_info; do
  # shellcheck source=/dev/null
  source "$ZOOMCTL_LIB_DIR/$library.sh" || exit 1
done

# main — dispatch the command line; every arm is a single call into a command_* function.
# Args:    $1 command; $2.. its arguments
# Returns: the command's status (0 ok, 1 error, 2 usage)
# Globals: none
main() {
  local command="${1:-help}"
  [ "$#" -eq 0 ] || shift
  case "$command" in
    in|zoom-in) zoomctl_command_in "$@" ;;  # zoom in by n steps
    out|zoom-out) zoomctl_command_out "$@" ;;  # zoom out by n steps
    zoom) zoomctl_command_zoom "$@" ;;  # absolute factor
    toggle) zoomctl_command_toggle "$@" ;;  # reset zoom <-> last zoom
    reset|hard-reset) zoomctl_command_reset "$@" ;;  # back to the reset zoom
    filter) zoomctl_command_filter "$@" ;;  # colour filter on/off/name
    tracking) zoomctl_command_tracking "$@" ;;  # pointer tracking mode
    set) zoomctl_command_set "$@" ;;  # save one setting
    get) zoomctl_command_get "$@" ;;  # read one setting
    unset) zoomctl_command_unset "$@" ;;  # drop one override
    reset-config) zoomctl_command_reset_config "$@" ;;  # drop all overrides
    config|show-config) zoomctl_command_config "$@" ;;  # show configuration
    preview) zoomctl_command_preview "$@" ;;  # live try-out for the UI
    status) zoomctl_command_status "$@" ;;  # zoom state
    doctor) zoomctl_command_doctor "$@" ;;  # installation checks
    setup|install-hyprland) zoomctl_command_setup "$@" ;;  # wire into Hyprland config
    ui|configure) zoomctl_command_ui "$@" ;;  # open the settings window
    edit-config) zoomctl_command_edit_config "$@" ;;  # edit the user file by hand
    uninstall|remove) zoomctl_command_uninstall "$@" ;;  # remove the package
    version|--version|-V) zoomctl_command_version ;;  # print the version
    help|-h|--help) zoomctl_command_help ;;  # usage text
    *) zoomctl_usage_error "unknown command '$command'" ;;  # exit 2
  esac
}

main "$@"
