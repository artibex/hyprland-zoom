#version 300 es
// hyprland-zoom colour filter "@FILTER_NAME@" - generated by the engine from src/shaders.
// Do not edit the generated file; edit base.glsl and filter-<name>.glsl instead.
precision highp float;

// Texture coordinate interpolated by Hyprland's full-screen vertex shader.
in vec2 v_texcoord;
// The colour written to the screen.
layout(location = 0) out vec4 fragColor;
// The finished (already zoomed) frame Hyprland hands to the screen shader.
uniform sampler2D tex;

// Settings baked in by the engine (schema keys FILTER_INTENSITY/CONTRAST/BRIGHTNESS/SATURATION).
const float FILTER_INTENSITY = @INTENSITY@;
const float FILTER_CONTRAST = @CONTRAST@;
const float FILTER_BRIGHTNESS = @BRIGHTNESS@;
const float FILTER_SATURATION = @SATURATION@;

// Rec. 709 luma weights, shared by the filters and the saturation step.
const vec3 LUMA_WEIGHTS = vec3(0.2126, 0.7152, 0.0722);

@FILTER_BODY@

// adjust_colour - apply contrast, brightness and saturation after the filter.
vec3 adjust_colour(vec3 colour) {
    // Contrast pivots around mid grey; brightness shifts everything afterwards.
    vec3 contrasted = (colour - 0.5) * FILTER_CONTRAST + 0.5 + FILTER_BRIGHTNESS;
    // Saturation blends between the grey luma value and the colour itself.
    float luma = dot(contrasted, LUMA_WEIGHTS);
    return clamp(mix(vec3(luma), contrasted, FILTER_SATURATION), 0.0, 1.0);
}

void main() {
    // Sample the frame; the alpha channel passes through untouched.
    vec4 source = texture(tex, v_texcoord);
    // Blend between the original (intensity 0) and the full filter (intensity 1).
    vec3 filtered = mix(source.rgb, apply_filter(source.rgb), FILTER_INTENSITY);
    fragColor = vec4(adjust_colour(filtered), source.a);
}
